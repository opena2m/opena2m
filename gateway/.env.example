# OpenA2M Gateway — environment configuration
# Copy to .env and edit for your environment

# Database (SQLite for dev, PostgreSQL for prod)
AIMP_DB_URL=sqlite+aiosqlite:///./opena2m.db
# AIMP_DB_URL=postgresql+asyncpg://opena2m:secret@localhost:5432/opena2m

# Redis (optional; disables pub/sub if not available)
AIMP_REDIS_URL=redis://localhost:6379/0

# Object Store (MinIO for dev, S3 for prod)
AIMP_OBJECT_STORE_ENDPOINT=http://localhost:9000
AIMP_OBJECT_STORE_BUCKET=aimp-media
AIMP_OBJECT_STORE_ACCESS_KEY=minioadmin
AIMP_OBJECT_STORE_SECRET_KEY=minioadmin

# Auth
AIMP_JWT_SECRET=dev-insecure-secret-change-me-in-production
AIMP_DEV=true
AIMP_DEV_TOKEN=dev-token

# Audit signing key (auto-generated if missing)
AIMP_AUDIT_PRIVATE_KEY_PATH=./keys/audit_ed25519.pem

# Gateway base URL
AIMP_BASE_URL=http://localhost:8080

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
